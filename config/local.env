# Local process settings for Verity Encounter.
# Secrets stay in .env (gitignored): VERITY_FACULTY_PASSWORD, OPENAI_API_KEY.
# This machine:
#   python run.py --config config/local.env
# Container (bind and database path are overridden in docker-compose.yml):
#   docker compose up --build

VERITY_HOST=127.0.0.1
VERITY_PORT=8080
VERITY_DB=data/verity.sqlite3
VERITY_COOKIE_SECURE=0
VERITY_BEHIND_PROXY=0
VERITY_SEMANTIC=1
VERITY_HARVEST=0
OPENAI_MODEL=gpt-4.1
HARVEST_TOPICS=fatigue hypothyroidism;penicillin allergy;chest tightness smoking
HARVEST_MAX_RECORDS=40
