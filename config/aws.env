# AWS / container settings for Verity Encounter.
# Do not put secrets in this file.
# Supply VERITY_FACULTY_PASSWORD (and OPENAI_API_KEY, if semantic routing is on)
# from the ECS task definition or Secrets Manager. See deploy/aws/ecs-task-definition.json.
#
#   docker run --env-file config/aws.env -p 8080:8080 -v verity-data:/data verity-encounter
#
# Replace verity.example.com with the public hostname served by the load balancer.
# Loopback is always allowed. With VERITY_BEHIND_PROXY=1, GET /api/health accepts
# any Host so a target-group check can use the task address.
# VERITY_ALLOWED_HOSTS=* turns the host check off; use that only behind TLS.
# SQLite at VERITY_DB is ephemeral on Fargate until an EFS volume is mounted at /data.
# Run one task against that file. SQLite is not a multi-writer database.

VERITY_HOST=0.0.0.0
VERITY_PORT=8080
VERITY_DB=/data/verity.sqlite3
VERITY_COOKIE_SECURE=1
VERITY_BEHIND_PROXY=1
VERITY_ALLOWED_HOSTS=verity.example.com
VERITY_SEMANTIC=0
VERITY_HARVEST=0
OPENAI_MODEL=gpt-4.1
HARVEST_TOPICS=fatigue hypothyroidism;penicillin allergy;chest tightness smoking
HARVEST_MAX_RECORDS=40
